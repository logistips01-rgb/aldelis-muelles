rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Permisos ──────────────────────────────────────────────────────────
    // Administradores con acceso total. Esta lista se replica en admin.js
    // (constante ADMINS); si cambia hay que cambiarla en los dos sitios.
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email in ['mlorente@aldelis.com'];
    }

    // Secciones concedidas al usuario que hace la peticion. Cuesta 1 lectura
    // por peticion (se cachea dentro de la misma), no 1 por documento.
    function miDocPermisos() {
      return /databases/$(database)/documents/permisos/$(request.auth.token.email);
    }

    // Refuerzo progresivo: mientras un usuario no tenga documento en /permisos
    // conserva el acceso que tenia antes (estar autenticado). En cuanto se le
    // crea el documento desde el panel, pasa a aplicarse de forma estricta.
    // Asi se puede desplegar sin dejar a nadie fuera de golpe.
    function sinDocPermisos() {
      return request.auth != null && !exists(miDocPermisos());
    }
    function permitido(seccion) {
      return request.auth != null && (
        esAdmin() || sinDocPermisos() || (
          get(miDocPermisos()).data.secciones is list
          && seccion in get(miDocPermisos()).data.secciones
        )
      );
    }

    // Control de frecuencia de los correos de restablecimiento de contraseña.
    // Solo lo toca la Cloud Function con el SDK de administrador: si un cliente
    // pudiera escribir aqui, podria saltarse el limite de un correo cada 5 min.
    match /password_resets/{email} {
      allow read, write: if false;
    }

    // Un usuario puede leer su propio documento de permisos (lo necesita el
    // panel al arrancar). Escribir y listar, solo los administradores.
    match /permisos/{email} {
      allow get:    if esAdmin() || (request.auth != null && request.auth.token.email == email);
      allow list:   if esAdmin();
      allow write:  if esAdmin();
    }

    // Ajustes. Lectura abierta porque las paginas publicas (lanzadera,
    // bizerba, reserva) necesitan config/app y config/destinos sin estar
    // autenticadas. La escritura se limita a quien tiene la seccion
    // correspondiente: antes bastaba estar autenticado.
    // Nota: en Firestore los match que solapan se combinan con OR, asi que
    // un usuario con "config" puede escribir tambien costes y bizerba.
    match /config/bizerba {
      allow read:  if true;
      allow write: if permitido('bizerba');
    }
    match /config/costes {
      allow read:  if true;
      allow write: if permitido('costes');
    }
    match /config/{id} {
      allow read:  if true;
      allow write: if permitido('config');
    }

    // Chat almacen <-> lanzaderas
    match /mensajes/{id} {
      allow read: if true;
      allow create: if validMensaje();
    }

    function validMensaje() {
      let d = request.resource.data;
      return d.lanzadera is number && d.lanzadera >= 1 && d.lanzadera <= 4
        && d.de in ['almacen', 'lanzadera']
        // El texto puede ir vacio si el mensaje es una foto, pero no las dos
        // cosas a la vez.
        && d.texto is string && d.texto.size() <= 500
        && (d.texto.size() > 0 || (d.foto is string && d.foto.size() > 0))
        // La miniatura viaja dentro del mensaje para que el chat se vea al
        // instante; la foto completa vive en /fotos y se pide al tocarla.
        && (!('thumb' in d) || (d.thumb is string && d.thumb.size() <= 30000))
        && (!('foto' in d)  || (d.foto  is string && d.foto.size() <= 60));
    }

    // Fotos del chat. La completa se guarda aparte del mensaje a proposito: si
    // fuera dentro, el chat descargaria todas las del dia en cada reconexion.
    // Se borran a los 3 dias (funcion limpiarFotos).
    match /fotos/{id} {
      allow read: if true;              // igual que mensajes: lanzadera.html no tiene login
      allow create: if validFoto();
      allow update: if false;           // una foto no se modifica
      allow delete: if request.auth != null;
    }

    function validFoto() {
      let d = request.resource.data;
      return d.keys().hasOnly(['b64', 'lanzadera', 'de', 'ts'])
        && d.lanzadera is number && d.lanzadera >= 1 && d.lanzadera <= 4
        && d.de in ['almacen', 'lanzadera']
        // Tope de tamaño: un documento de Firestore no pasa de 1 MB, y en base64
        // una imagen crece un tercio. 700.000 caracteres deja margen de sobra.
        && d.b64 is string && d.b64.size() > 0 && d.b64.size() <= 700000;
    }

    match /reservas/{id} {
      // Lectura: abierta de momento (la consulta publica y el calculo de
      // franjas la necesitan). Se cierra en la Fase 2 con App Check.
      allow read: if true;

      // Crear: solo reservas con formato valido y estado inicial controlado.
      allow create: if validReserva();

      // Modificar / borrar: solo personal autenticado (almacen).
      allow update, delete: if request.auth != null;
    }

    // Estado en vivo de las lanzaderas (una doc por lanzadera, id "1".."4").
    // App Check ya restringe la escritura a la propia web.
    match /lanzaderas/{id} {
      allow read: if true;
      allow create, update: if validLanzadera();
    }

    // Furgoneta: modulo aparte y minimo (sin chat, sin GPS, sin coste), un
    // unico vehiculo. Misma logica que lanzaderas pero sin numero ni muelle.
    match /furgoneta/{id} {
      allow read: if true;
      allow create, update: if validFurgoneta();
    }
    match /furgoneta_log/{id} {
      allow read: if permitidoEstricto('furgoneta');
      allow create: if validFurgoneta();
    }
    function validFurgoneta() {
      let d = request.resource.data;
      return d.estado in ['en_nave', 'transito', 'fuera']
        && d.nave is string && d.nave.size() > 0 && d.nave.size() <= 60
        && (d.destino == null || (d.destino is string && d.destino.size() <= 60))
        && (!('motivo' in d) || d.motivo == null || (d.motivo is string && d.motivo.size() <= 120))
        && d.activa is bool;
    }

    // Coordenadas GPS aprendidas de cada nave (Plaza, Merca, Caserfri...), a
    // partir de las lecturas reales de los choferes al llegar. Se usan para
    // dibujar en el mapa hacia donde va una lanzadera en transito.
    match /ubicaciones_naves/{id} {
      allow read: if permitido('lanzaderas');
      allow create, update: if validUbicacionNave();
    }

    // Pedidos de transferencia a almacenes externos (un documento por
    // codigo PT, subido desde el panel o por el correo automatico). Lectura
    // abierta porque el movil del chofer (sin login) necesita ver que PT
    // hay pendientes en cada almacen para poder marcarlos al salir. No es
    // un dato sensible (solo codigos y cantidades). Solo el panel los
    // crea/corrige (via Cloud Function); "recogido"/"cerrado" los toca
    // siempre el servidor, nunca el cliente directamente.
    match /pedidos_transferencia/{id} {
      allow read: if true;
      allow create, update: if permitido('lanzaderas') && validPedidoTransferencia();
    }

    // Saldo pendiente por almacen (avitrans/caserfri/txt): lo mantiene solo
    // el servidor (sumando pedidos_transferencia y restando recogidas_palets),
    // nunca se escribe desde el cliente. Lectura abierta porque el movil del
    // chofer no tiene login y necesita verlo.
    match /almacenes_pendientes/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Registro de "cuantos palets llevo" al salir de un almacen externo. Lo
    // escribe el chofer (sin login, como el resto de su flujo); el servidor
    // usa cada alta para descontar del saldo pendiente.
    match /recogidas_palets/{id} {
      allow read: if permitido('lanzaderas');
      allow create: if validRecogidaPalets();
    }

    // Historico de movimientos (para informes). Solo se anade, no se edita.
    // Lo necesitan las vistas de lanzaderas, costes, cargas, merca y arento.
    match /lanzaderas_log/{id} {
      allow read: if permitido('lanzaderas') || permitido('costes')
                  || permitido('cargas') || permitido('merca') || permitidoEstricto('arento');
      allow create: if validLanzadera();
    }

    // Indicaciones para las lanzaderas (una doc por lanzadera). El conductor
    // las lee al salir; el almacen las escribe; el conductor las limpia.
    match /lanzaderas_nota/{id} {
      allow read: if true;
      allow create, update: if validNota();
    }

    // Quien conduce cada lanzadera y su telefono, para poder llamarle.
    // La escritura es abierta porque el conductor no tiene login, pero la
    // LECTURA no: es un telefono, dato personal, y solo lo ve quien tenga la
    // seccion de lanzaderas en el panel. El movil del conductor no necesita
    // leerlo: recuerda sus datos en el propio dispositivo.
    match /lanzaderas_chofer/{id} {
      allow read: if permitido('lanzaderas');
      allow create, update: if validChofer();
    }

    function validChofer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['numero', 'nombre', 'telefono', 'ts'])
        && d.numero is number && d.numero >= 1 && d.numero <= 4
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.telefono is string && d.telefono.size() <= 20;
    }

    function validNota() {
      let d = request.resource.data;
      return d.numero is number && d.numero >= 1 && d.numero <= 4
        && d.nota is string && d.nota.size() <= 200;
    }

    // Cargas (registro al momento en muelles de carga M1-M5).
    // Lectura solo almacen (incluye DNI). Crear: transportista o almacen.
    match /cargas/{id} {
      allow read: if permitido('cargas');
      allow create: if validCarga();
      allow update, delete: if permitido('cargas');
    }

    function validCarga() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'matricula_tractora','matricula_semi','chofer','dni',
          'destino','muelle','estado','inicio','fin','created_at'
        ])
        && d.estado == 'cargando'
        && d.fin == null
        && d.muelle in ['M1','M2','M3','M4','M5']
        && d.matricula_tractora is string && d.matricula_tractora.size() > 0 && d.matricula_tractora.size() <= 20
        && d.matricula_semi is string && d.matricula_semi.size() <= 20
        && d.chofer is string && d.chofer.size() <= 120
        && d.dni is string && d.dni.size() <= 20
        && d.destino is string && d.destino.size() <= 120;
    }

    // Descargas de proveedores en Merca (otro almacen). Registro al momento.
    match /descargas_merca/{id} {
      allow read: if permitido('merca');
      allow create: if validMerca();
      allow update, delete: if permitido('merca');
    }

    function validMerca() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'empresa','matricula','mercancia','pales','muelle','estado','inicio','fin','created_at'
        ])
        && d.estado == 'descargando'
        && d.fin == null
        && d.muelle in ['M2','M4']
        && d.empresa is string && d.empresa.size() > 0 && d.empresa.size() <= 120
        && d.matricula is string && d.matricula.size() > 0 && d.matricula.size() <= 20
        && d.mercancia is string && d.mercancia.size() <= 300
        && (d.pales == null || d.pales is number);
    }

    // Descargas de proveedores en Arento (otro almacen, muelles A1/A2/A3).
    // Seccion nueva, permiso estricto (ver permitidoEstricto mas abajo).
    match /descargas_arento/{id} {
      allow read: if permitidoEstricto('arento');
      allow create: if validArento();
      allow update, delete: if permitidoEstricto('arento');
    }

    function validArento() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'empresa','matricula','mercancia','pales','muelle','estado','inicio','fin','created_at'
        ])
        && d.estado == 'descargando'
        && d.fin == null
        && d.muelle in ['A1','A2','A3']
        && d.empresa is string && d.empresa.size() > 0 && d.empresa.size() <= 120
        && d.matricula is string && d.matricula.size() > 0 && d.matricula.size() <= 20
        && d.mercancia is string && d.mercancia.size() <= 300
        && (d.pales == null || d.pales is number);
    }

    // Tokens de notificaciones push (un doc por dispositivo).
    // Los clientes solo escriben su token; el envio lo hace la Cloud Function.
    match /push_tokens/{id} {
      allow read: if request.auth != null;
      allow create, update: if validToken();
      allow delete: if request.auth != null;
    }

    function validToken() {
      let d = request.resource.data;
      return d.token is string && d.token.size() > 0 && d.token.size() <= 400
        && d.rol in ['almacen', 'lanzadera']
        && (d.lanzadera == null || (d.lanzadera is number && d.lanzadera >= 1 && d.lanzadera <= 4));
    }

    // Incidencias Bizerba: produccion abre, el tecnico coge y resuelve.
    // Lectura abierta (la app del tecnico la necesita sin login, como lanzaderas).
    match /incidencias/{id} {
      allow read: if true;
      allow create, update: if validIncidencia();
      allow delete: if request.auth != null;
    }

    function validIncidencia() {
      let d = request.resource.data;
      return d.linea is number && d.linea >= 0 && d.linea <= 16
        && d.estado in ['abierta', 'aceptada', 'repuesto', 'resuelta']
        && d.averia is string && d.averia.size() <= 300
        && (d.observaciones == null || (d.observaciones is string && d.observaciones.size() <= 500))
        && (d.tecnico == null || (d.tecnico is number && d.tecnico >= 1 && d.tecnico <= 99));
    }

    function validLanzadera() {
      let d = request.resource.data;
      return d.numero is number && d.numero >= 1 && d.numero <= 4
        && d.estado in ['en_nave', 'transito', 'fuera']
        && d.nave is string && d.nave.size() > 0 && d.nave.size() <= 60
        && d.accion in ['presente','cargando','descargando']
        && (d.muelle == null || (d.muelle is string && d.muelle.size() <= 10))
        && (d.destino == null || (d.destino is string && d.destino.size() <= 60))
        && d.activa is bool
        && (d.lat == null || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (d.lng == null || (d.lng is number && d.lng >= -180 && d.lng <= 180));
    }

    function validUbicacionNave() {
      let d = request.resource.data;
      return d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180;
    }

    function validPedidoTransferencia() {
      let d = request.resource.data;
      return d.almacen in ['avitrans', 'caserfri', 'txt']
        && d.palets is number && d.palets >= 0 && d.palets <= 2000
        && d.recogido is number && d.recogido >= 0
        && d.cerrado is bool
        && d.creado is timestamp;
    }

    function validRecogidaPalets() {
      let d = request.resource.data;
      return d.numero is number && d.numero >= 1 && d.numero <= 4
        && d.almacen in ['avitrans', 'caserfri', 'txt']
        && d.palets is number && d.palets >= 0 && d.palets <= 2000
        && d.ts is timestamp;
    }

    function validReserva() {
      let d = request.resource.data;
      return
        // Solo se admiten exactamente estos campos
        d.keys().hasOnly([
          'codigo','matricula','empresa','conductor','email','temperatura',
          'seccion','mercancia','pales','peso','observaciones','franja',
          'fecha','estado','muelle','nota_almacen','motivo','created_at'
        ])
        // El que reserva no puede auto-confirmarse ni asignarse muelle
        && d.estado == 'pendiente'
        && d.muelle == null
        && d.nota_almacen == ''
        && d.motivo == ''
        // Seccion valida
        && d.seccion in ['seco','frio','lavadero']
        // Campos obligatorios con limite de longitud
        && d.matricula is string && d.matricula.size() > 0 && d.matricula.size() <= 20
        && d.empresa   is string && d.empresa.size()   > 0 && d.empresa.size()   <= 120
        && d.codigo    is string && d.codigo.size()    <= 40
        && d.franja    is string && d.franja.size()    <= 20
        && d.fecha     is string && d.fecha.size()     <= 10
        // Campos opcionales con tope de longitud
        && d.conductor     is string && d.conductor.size()     <= 120
        && d.email         is string && d.email.size()         <= 160
        && d.mercancia     is string && d.mercancia.size()     <= 300
        && d.observaciones is string && d.observaciones.size() <= 500
        && d.temperatura   is string && d.temperatura.size()   <= 20
        // Numericos: numero o nulo
        && (d.pales == null || d.pales is number)
        && (d.peso  == null || d.peso  is number);
    }

    // ── Cambios de material (etiquetas/bandejas) ────────────────────────────
    // Modulo con permiso propio y estricto: sin ficha en /permisos que lo
    // incluya, no hay acceso (a diferencia de permitido(), que deja pasar a
    // quien no tiene ficha, pensado para secciones que ya existian antes del
    // sistema de permisos). Una seccion nueva no tiene ese pasado que proteger.
    function permitidoEstricto(seccion) {
      return request.auth != null && (
        esAdmin() || (
          exists(miDocPermisos())
          && get(miDocPermisos()).data.secciones is list
          && seccion in get(miDocPermisos()).data.secciones
        )
      );
    }

    // ── Compras (bandejas) ───────────────────────────────────────────────
    // El maestro se gestiona a mano desde el panel (altas/bajas, stock de
    // seguridad, incremento por ofertas...). El resto (stock, transito,
    // consumos, pedido base, planificacion) solo lo escribe el servidor,
    // al leer los correos del ERP - el cliente solo lee, para el dashboard.
    match /compras_bandejas_maestro/{referencia} {
      allow read: if permitidoEstricto('compras');
      allow create, update, delete: if permitidoEstricto('compras') && validComprasBandejasMaestro();
    }
    function validComprasBandejasMaestro() {
      let d = request.resource.data;
      return d.descripcion is string && d.descripcion.size() <= 200
        && d.leadTime is number && d.leadTime >= 0
        && d.stockSeguridad is number && d.stockSeguridad >= 0
        && d.unidadesPalet is number && d.unidadesPalet > 0
        && d.incremento is number && d.incremento >= 0
        && d.situacion in ['ACTIVA', 'BAJA', 'MERCA'];
    }
    match /compras_bandejas_stock/{referencia}        { allow read: if permitidoEstricto('compras'); allow write: if false; }
    match /compras_bandejas_transito/{referencia}      { allow read: if permitidoEstricto('compras'); allow write: if false; }
    match /compras_bandejas_consumos/{id}              { allow read: if permitidoEstricto('compras'); allow write: if false; }
    match /compras_bandejas_pedido_base/{referencia}   { allow read: if permitidoEstricto('compras'); allow write: if false; }
    match /compras_bandejas_planificacion/{referencia} { allow read: if permitidoEstricto('compras'); allow write: if false; }

    // Contador diario de preguntas a Robin en el chat de lanzaderas (limite
    // configurable en config/robin). Solo lo escribe el servidor; el panel
    // solo lo lee, para poder mostrar cuanto se ha usado hoy.
    match /robin_chat_uso/{fecha} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Quien puede configurar el stock minimo/pedido de envases, sin darle
    // el resto de permisos de esAdmin() (gestionar usuarios, tareas
    // programadas de Robin, etc.).
    function esAdminEnvases() {
      return request.auth != null
        && request.auth.token.email in ['mlorente@aldelis.com', 'hmanero@aldelis.com'];
    }

    // Stock minimo / incremento por referencia de envases, para el pedido
    // automatico por correo (revisarCorreoStockMinimoEnvases). Solo se
    // configura desde el panel por un admin, nunca desde la plantilla de
    // Excel que se manda por correo, para que nadie pueda manipularlo.
    match /envases_stock_minimo_config/{referencia} {
      allow read: if esAdminEnvases();
      allow create, update: if esAdminEnvases() && validEnvasesStockMinimoConfig();
      allow delete: if esAdminEnvases();
    }
    function validEnvasesStockMinimoConfig() {
      let d = request.resource.data;
      return d.stockMinimo is number && d.stockMinimo >= 0
        && d.incremento is number && d.incremento >= 0
        // porcentajeAuto es opcional (si no viene, se usa el 40% por defecto).
        && (!('porcentajeAuto' in d) || (d.porcentajeAuto is number && d.porcentajeAuto >= 0 && d.porcentajeAuto <= 100))
        // almacen es opcional (si no viene, se pide a avitrans por defecto).
        && (!('almacen' in d) || d.almacen in ['avitrans', 'txt']);
    }

    // Marca de "hoy ya se ha mandado el pedido automatico diario (11:30)",
    // para no repetirlo si se prueba a mano el mismo dia. Solo el servidor.
    match /envases_stock_minimo_auto_dia/{fecha} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Carton: mismo maestro editable a mano; stock/consumo/transito/pedido
    // base son los MISMOS documentos que bandejas (misma recogida de datos,
    // los mismos almacenes), asi que no hace falta duplicar esas reglas.
    match /compras_carton_maestro/{referencia} {
      allow read: if permitidoEstricto('compras');
      allow create, update, delete: if permitidoEstricto('compras') && validComprasBandejasMaestro();
    }

    match /cambios_material/{id} {
      allow read: if permitidoEstricto('cambios');
      allow create, update: if permitidoEstricto('cambios') && validCambioMaterial();
    }

    function validCambioMaterial() {
      let d = request.resource.data;
      return d.tipo in ['etiqueta', 'bandeja']
        && d.referenciaActual is string && d.referenciaActual.size() <= 60
        && d.referenciaNueva  is string && d.referenciaNueva.size() > 0 && d.referenciaNueva.size() <= 60
        && d.motivo is string && d.motivo.size() <= 80
        && d.agotarStock is bool
        && (d.fechaArranque == null || (d.fechaArranque is string && d.fechaArranque.size() <= 10))
        && d.descripcion  is string && d.descripcion.size()  <= 1000
        && d.observaciones is string && d.observaciones.size() <= 1000
        && (!('imagen' in d) || d.imagen == null || (d.imagen is string && d.imagen.size() <= 700000))
        && (!('pdfBase64' in d) || d.pdfBase64 == null || (d.pdfBase64 is string && d.pdfBase64.size() <= 700000))
        && (!('pdfPreviewBase64' in d) || d.pdfPreviewBase64 == null || (d.pdfPreviewBase64 is string && d.pdfPreviewBase64.size() <= 700000))
        && (!('pdfNombre' in d) || d.pdfNombre == null || (d.pdfNombre is string && d.pdfNombre.size() <= 150))
        && d.estado in ['pendiente', 'confirmado', 'ejecutado']
        && d.creadoPor is string;
    }

    match /cambios_mensajes/{id} {
      allow read: if permitidoEstricto('cambios');
      allow create: if permitidoEstricto('cambios') && validCambioMensaje();
    }

    function validCambioMensaje() {
      let d = request.resource.data;
      return d.cambioId is string && d.cambioId.size() > 0
        && d.emisor is string && d.emisor.size() <= 120
        && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 1000;
    }

    // ── Tareas programadas (sin IA, sin gasto de tokens) ────────────────────
    // El propio panel crea/edita/borra estos documentos directamente (sin
    // Cloud Function): solo el administrador puede usarlos. La ejecucion la
    // hace unicamente el servidor (ejecutarTareasProgramadas), que reutiliza
    // iaEnviarCorreo/iaEnviarMensajeChat sin llamar nunca a la IA.
    match /tareas_programadas/{id} {
      allow read: if esAdmin();
      allow create, update: if esAdmin() && validTareaProgramada();
      allow delete: if esAdmin();
    }

    function validTareaProgramada() {
      let d = request.resource.data;
      return d.tipo in ['enviar_correo', 'enviar_mensaje_chat']
        && d.recurrencia in ['ninguna', 'diaria', 'semanal']
        && d.activa is bool
        && d.proximaEjecucion is timestamp
        && d.parametros is map
        && d.creadoPor is string
        && d.creado is timestamp;
    }

  }
}
